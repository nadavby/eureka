PORT=3000
DB_CONNECTION=mongodb://localhost:27017/eureka
DOMAIN_BASE=http://localhost:3000
TOKEN_SECRET=change-me-to-a-random-string-of-32-chars-or-more
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
# Gemini (Google AI Studio). Without a key the API works but items are marked "matching failed".
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# Local guard against free-tier quota errors
AI_REQUESTS_PER_MINUTE=12
# memory (default outside production) or atlas (requires the index in atlas/vector-index.json)
VECTOR_SEARCH=memory
MATCH_RADIUS_KM=10
MATCH_THRESHOLD=70
GOOGLE_CLIENT_ID=
# Image storage. With CLOUDINARY_URL set, photos go to Cloudinary; otherwise to backend/public (dev only:
# hosts like Render have no persistent disk). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Frontend origin(s) allowed by CORS, comma-separated (e.g. https://eureka.example.com)
CLIENT_URL=http://localhost:5173
# Optional: serve HTTPS directly (otherwise terminate TLS at a proxy / load balancer)
SSL_KEY_PATH=
SSL_CERT_PATH=
